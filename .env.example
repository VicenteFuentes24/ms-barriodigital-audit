# Template only. Spring Boot does NOT load .env automatically.
SERVER_PORT=8084
DB_URL=jdbc:postgresql://YOUR_SUPABASE_SESSION_POOLER_HOST:5432/postgres?sslmode=verify-full
DB_USERNAME=YOUR_DATABASE_USER
DB_PASSWORD=
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=2
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=1
# Explicitly enable only after reviewing V1 and authorizing its application.
AUDIT_MIGRATIONS_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:19092,localhost:29092,localhost:39092
KAFKA_AUDIT_GROUP_ID=bd-audit-v1
KAFKA_LISTENER_ENABLED=true
KAFKA_CONSUMER_RETRIES=3
KAFKA_RETRY_DELAY_MS=1000
AUDIT_QUERY_ZONE=America/Santiago
AZURE_TENANT_ID=
AZURE_API_AUDIENCE=
